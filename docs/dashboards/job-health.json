        "rowSpan": 4
      },
      "metadata": {
        "colors": {}
      },
      "data": {
        "baseType": "Timeseries",
        "type": "applicationInsightsEntityData",
        "query": "customEvents\n| where name == 'dlq_count'\n| summarize count() by bin(timestamp, 1h)",
        "title": "Deletion job lag proxy (M0: dlq_count is the closed-set proxy — dedicated deletion-lag metric not in TA-10.2 set yet)"
