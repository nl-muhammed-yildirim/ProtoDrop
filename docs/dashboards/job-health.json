      }
    },
    {
      "type": "ApplicationInsights.MsQuotedVersionedDashboardItem",
      "id": "6a931f33-ebe6-4496-8bae-f942f19ee8d4",
      "name": "Expiry lag threshold reference",
      "position": {
        "x": 9,
        "y": 0,
        "colSpan": 3,
        "rowSpan": 4
      },
      "metadata": {
        "colors": {}
      },
      "data": {
        "baseType": "Timeseries",
        "type": "applicationInsightsEntityData",
        "query": "range t in range(ago(24h), now(), 1h)\n| extend value = 1800.0\n| project timestamp = t, value",
        "title": "Expiry lag threshold reference: 1800 s (30 min)"
      }
    },
    {
      "type": "ApplicationInsights.MsQuotedVersionedDashboardItem",
      "id": "2308e9ab-502e-4bf7-bcf5-2fe0f4881280",
      "name": "Deletion job lag proxy",
